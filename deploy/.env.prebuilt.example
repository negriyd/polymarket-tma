# Used with docker-compose.prebuilt.yml on the server (pull-only, no build).
# Copy these lines into deploy/.env next to BOT_TOKEN, JWT_SECRET, etc.

# Full image references including registry and tag (same tag for both is fine).
BACKEND_IMAGE=docker.io/YOUR_DOCKERHUB_USER/polymarket-tma-backend:latest
FRONTEND_IMAGE=docker.io/YOUR_DOCKERHUB_USER/polymarket-tma-frontend:latest

# Examples:
# Docker Hub:   docker.io/janedoe/polymarket-tma-backend:2025-05-14
# GHCR:         ghcr.io/janedoe/polymarket-tma-backend:2025-05-14
