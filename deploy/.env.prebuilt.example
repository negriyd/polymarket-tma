# Used with docker-compose.prebuilt.yml on the server (pull-only, no build).
# Copy these lines into deploy/.env next to BOT_TOKEN, JWT_SECRET, etc.

# Full image references including registry and tag (same tag for both is fine).
BACKEND_IMAGE=docker.io/YOUR_DOCKERHUB_USER/polymarket-tma-backend:latest
FRONTEND_IMAGE=docker.io/YOUR_DOCKERHUB_USER/polymarket-tma-frontend:latest

# Examples:
# Docker Hub:   docker.io/janedoe/polymarket-tma-backend:2025-05-14
# GHCR:         ghcr.io/janedoe/polymarket-tma-backend:2025-05-14

# --- Backend RUNTIME env (Spring Boot reads them at start, NOT baked into the image) ---
# Platform fee (optional). spread-bps in basis points (50 = 0.5%); recipient is the Polygon
# wallet that receives the USDC fee. Set both to enable monetization.
TRADING_FEE_BPS=0
TRADING_FEE_RECIPIENT=

# Geoblock note: international Polymarket CLOB rejects US, Germany, UK, Canada, Singapore and
# OFAC-sanctioned IPs with HTTP 403 "Trading restricted in your region". Verified working
# datacenters: Hetzner HEL1 (Helsinki), AWS eu-west-1 (Dublin). See docs/trading.md for the
# full table. After deploy: curl http://localhost:8080/api/diagnostics/clob-post-probe — must
# return 400/401/422, NOT 403.
