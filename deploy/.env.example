# Telegram
BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Inline mode (@bot <query> in any chat): public webhook URL + a random secret ([A-Za-z0-9_-]).
# Also enable inline mode for the bot in @BotFather (/setinline).
TELEGRAM_WEBHOOK_URL=https://your-domain/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# JWT
JWT_SECRET=replace-with-at-least-32-chars-of-random-secret-1234567890

# Frontend — base URL for REST + SockJS (baked in at `docker compose build`).
#
# `pnpm dev`: use http://localhost:8080
#
# Docker Compose + Telegram + ONE cloudflared tunnel to the SPA (port 5173): leave empty so the nginx
# in the frontend container proxies /api and /ws to the backend (same origin — no second tunnel).
#   VITE_API_BASE_URL=
#
# Or use a second tunnel to :8080 and set the HTTPS URL here (nginx proxy unused for API).
# Never use localhost for the Mini App on a real device.
VITE_API_BASE_URL=http://localhost:8080

# Frontend-only (must be set at `docker compose build` for Privy / Polygon in the SPA).
# Use the same app id shown in Privy Dashboard (often matches `PRIVY_APP_ID` below).
VITE_PRIVY_APP_ID=
VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# Frontend Docker build — Node heap for `pnpm build` inside Docker (megabytes).
# On a 2GB RAM VPS use 1536 (with swap) or build the frontend image locally/CI.
NODE_MEMORY_MB=4096

# --- Pre-built images (server / pull-only). See docker-compose.prebuilt.yml + .env.prebuilt.example
# BACKEND_IMAGE=docker.io/youruser/polymarket-tma-backend:latest
# FRONTEND_IMAGE=docker.io/youruser/polymarket-tma-frontend:latest

# Polymarket (defaults usually work)
# POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Polygon RPC (Phase 2)
POLYGON_RPC_URL=https://polygon-rpc.com

# Privy (Phase 2)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# CORS patterns (comma-separated) for REST + WebSocket. Use origin patterns, e.g. https://*.trycloudflare.com
# for Cloudflare quick tunnels (new host each run). Always keep https://web.telegram.org for some clients.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://web.telegram.org,https://*.trycloudflare.com

# Polymarket geoblock — informational only.
#
# International CLOB returns HTTP 403 "Trading restricted in your region" when the server's
# outbound IP is in a restricted jurisdiction. Backend surfaces error code CLOB_GEOBLOCKED.
#
# Allowed (verified):  Hetzner HEL1 Helsinki, AWS eu-west-1 Dublin.
# Probably allowed:    Vultr Stockholm/Madrid, DigitalOcean ams3 (UI blocked but CLOB API often
#                      works) — verify with /api/diagnostics/clob-post-probe before committing.
# Blocked:             ALL US regions (nyc1/sfo3/us-east-1 — international CLOB rejects them;
#                      a separate CFTC-regulated US API with KYC is required for US trading),
#                      Germany (fra1/NBG/FSN/FRA), UK, Canada (TOR1), Singapore, India,
#                      OFAC-sanctioned countries.
#
# After deploy: curl http://localhost:8080/api/diagnostics/clob-post-probe
#   Expect status 400/401/422 (proxy/payload error). 403 with "Trading restricted" → wrong region.

# Platform fee (Phase 2 monetization, optional). spread-bps in basis points (50 = 0.5%);
# recipient-address is the Polygon wallet receiving the USDC fee. Set both to enable.
TRADING_FEE_BPS=0
TRADING_FEE_RECIPIENT=
# Referral program: referrer's share of the trading fee (2500 = 25%) and how long it lasts.
REFERRAL_SHARE_BPS=2500
REFERRAL_DURATION=P365D

# Internal parimutuel betting (primary path — see docs/internal-bets-plan_RU.md, docs/bets-setup_RU.md).
# Users send USDC to treasury; bets are recorded in PostgreSQL and resolved off-chain (Phase 2).
BETS_ENABLED=false
# Falls back to TRADING_FEE_RECIPIENT when unset.
BETS_TREASURY_ADDRESS=
BETS_PLATFORM_FEE_BPS=500
BETS_MIN_USDC=1
BETS_MIN_WITHDRAW_USDC=1
BETS_LOCK_MINUTES=15
BETS_GRACE_HOURS=24
BETS_WITHDRAW_COOLDOWN_MINUTES=5
# Hot wallet private key (no 0x prefix ok) — required for on-chain withdraw to user wallets.
BETS_TREASURY_PRIVATE_KEY=
# Admin manual resolve/cancel: curl -H "X-Admin-Secret: $BETS_ADMIN_SECRET" ...
BETS_ADMIN_SECRET=

# Polymarket Relayer (CLOB v2 deposit wallets). polymarket.com -> Settings -> Builders
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# Optional bytes32 builder code for Polymarket bridge attribution
POLY_BUILDER_CODE=
