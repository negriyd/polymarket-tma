# Telegram
BOT_TOKEN=123456789:replace-with-token-from-BotFather

# JWT
JWT_SECRET=replace-with-at-least-32-chars-of-random-secret-1234567890

# Frontend — base URL for REST + SockJS (must be reachable from the phone / Telegram WebView).
#
# Browser dev on the same machine:  http://localhost:8080 is OK.
# Telegram Mini App over cloudflared: use a SECOND tunnel to port 8080, e.g.
#   cloudflared tunnel --url http://localhost:8080
# then set:
#   VITE_API_BASE_URL=https://your-api-tunnel.trycloudflare.com
# Never use localhost for the Mini App on a real device — see docs/setup.md §2.
VITE_API_BASE_URL=http://localhost:8080

# Polymarket (defaults usually work)
# POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Polygon RPC (Phase 2)
POLYGON_RPC_URL=https://polygon-rpc.com

# Privy (Phase 2)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# CORS allowed origins (comma-separated). Must include the SPA origin the WebView uses:
# local: http://localhost:5173; Telegram dev: https://your-frontend-tunnel.trycloudflare.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://web.telegram.org
